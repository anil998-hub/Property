{#
/**
 * @file
 * Theme override of an image.
 *
 * Available variables:
 * - attributes: HTML attributes for the img tag.
 * - style_name: (optional) The name of the image style applied.
 *
 * @see template_preprocess_image()
 */
#}

{# Only add classes if style_name exists and is NOT 'webp_no_class' #}
{% if style_name and style_name != 'webp_no_class' %}
  {% set classes = ['image-style-' ~ style_name|clean_class] %}
  <img{{ attributes.addClass(classes) }}/>
{% else %}
  <img{{ attributes }}/>
{% endif %} 