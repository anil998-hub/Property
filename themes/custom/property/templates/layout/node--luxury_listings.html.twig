<!-- Include FancyBox CSS and JS -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fancyapps/ui@5.0/dist/fancybox/fancybox.css">
 <script src="https://cdn.jsdelivr.net/npm/@fancyapps/ui@5.0/dist/fancybox/fancybox.umd.js"></script>

 <script>
document.addEventListener('DOMContentLoaded', function() {
    // Initialize FancyBox
    Fancybox.bind('[data-fancybox="gallery"]', {
        // Options
        infinite: true,
        zoom: true,
        showClass: "fadeIn",
        hideClass: "fadeOut",
        closeButton: true,
        thumbs: {
            autoStart: true,
            axis: 'x'
        },
        caption: function(fancybox, slide) {
            return slide.caption || slide.index + 1 + ' / ' + slide.group.length;
        },
        Toolbar: {
            display: {
                left: [],
                middle: ['zoomIn', 'zoomOut', 'slideshow'],
                right: ['close']
            }
        },
        on: {
            done: function(fancybox, slide) {
                // Optional: Add any custom behavior when a slide loads
            }
        }
    });

    // Open gallery when clicking on the tag-property (Photos count)
    window.openGallery = function() {
        // Find all gallery links
        var galleryLinks = document.querySelectorAll('[data-fancybox="gallery"]');
        if (galleryLinks.length > 0) {
            // Click the first link to open the gallery
            galleryLinks[0].click();
        }
    };

    // Also open gallery when clicking on the main image
    var mainImage = document.querySelector('.img-1 .image-wrap');
    if (mainImage) {
        mainImage.addEventListener('click', function(e) {
            e.preventDefault();
            var galleryLinks = document.querySelectorAll('[data-fancybox="gallery"]');
            if (galleryLinks.length > 0) {
                galleryLinks[0].click();
            }
        });
    }
});
</script>

	<style>
/* FancyBox Custom Styles */
.fancybox__container {
	background: rgba(0, 0, 0, 0.92);
}

.fancybox__slide {
	padding: 20px;
}

.fancybox__slide img {
	max-width: 100%;
	max-height: 90vh;
	object-fit: contain;
	border-radius: 8px;
	box-shadow: 0 10px 40px rgba(0, 0, 0, 0.3);
}

.fancybox__caption {
	background: rgba(0, 0, 0, 0.6);
	backdrop-filter: blur(10px);
	padding: 12px 20px;
	border-radius: 8px;
	font-size: 14px;
	color: #fff;
	bottom: 30px;
}

.fancybox__thumbs {
	background: rgba(0, 0, 0, 0.5);
	padding: 10px 0;
}

.fancybox__thumbs .carousel__slide {
	padding: 0 5px;
}

.fancybox__thumbs .carousel__slide .fancybox__thumb {
	border: 2px solid transparent;
	border-radius: 4px;
	transition: all 0.3s ease;
}

.fancybox__thumbs .carousel__slide .fancybox__thumb.is-active {
	border-color: #f58634;
}

.fancybox__thumbs .carousel__slide .fancybox__thumb:hover {
	border-color: rgba(245, 134, 52, 0.5);
}

/* Gallery Tag Button */
.tag-property {
	cursor: pointer;
	transition: all 0.3s ease;
}

.tag-property:hover {
	transform: scale(1.05);
	background: rgba(245, 134, 52, 0.9);
}

/* Image Wrapper Cursor */
.image-wrap {
	cursor: pointer;
}

/* Responsive adjustments for FancyBox */
@media(max-width: 767px) {
	.fancybox__slide {
		padding: 10px;
	}

	.fancybox__slide img {
		max-height: 80vh;
	}

	.fancybox__caption {
		font-size: 12px;
		padding: 8px 15px;
		bottom: 15px;
	}

	.fancybox__thumbs {
		display: none;
	}
}
</style>

	<section class="section-property-detail"> <div class="tf-container">
