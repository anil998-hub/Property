																																											</ul>
																																										</div> #}
					</div>
					<div class="info-detail">
						<div class="wrap-box">
							{% set garages = node.field_list.value|render|striptags|trim %}
							{% if garages is not empty %}
								<div class="box-icon">
									<div class="icons">
										<i class="icon-Garage-1"></i>
									</div>
									<div class="content">
										<div class="text-4 text-color-default">Garages</div>
										<div class="text-1 text-color-heading">{{ node.field_list.value|render|striptags|trim }}</div>
									</div>
								</div>
							{% endif %}
							{% set bathrooms = node.field_baths.value|render|striptags|trim %}
							{% if bathrooms is not empty %}
								<div class="box-icon">
									<div class="icons">
										<i class="icon-Bathtub"></i>
									</div>
									<div class="content">
										<div class="text-4 text-color-default">Bathrooms:</div>
										<div class="text-1 text-color-heading">{{ bathrooms }}Rooms</div>
									</div>
								</div>
							{% endif %}
						</div>
						<div class="wrap-box">
							<div class="box-icon">
								<div class="icons">
									<i class="icon-SlidersHorizontal"></i>
								</div>
								<div class="content">
									<div class="text-4 text-color-default">Type:</div>
									<div class="text-1 text-color-heading">{{ node.field_properties.entity.label }}</div>
								</div>
							</div>
							<div class="box-icon">
								<div class="icons">
									<i class="icon-Crop"></i>
								</div>
								<div class="content">
									<div class="text-4 text-color-default">Land Size:</div>
									<div class="text-1 text-color-heading">{{ node.field_sqft.value|render|striptags|trim }}SqFt</div>
								</div>
							</div>
						</div>
						<div class="wrap-box">
							{% set beds = node.field_beds.value|render|striptags|trim %}
							{% if beds is not empty %}
								<div class="box-icon">
									<div class="icons">
										<i class="icon-Bed-2"></i>
									</div>
									<div class="content">
										<div class="text-4 text-color-default">Bedrooms:</div>
										<div class="text-1 text-color-heading">{{ beds }}
											Rooms</div>
									</div>
								</div>
							{% endif %}
							{% set bathrooms = node.field_sqft.value|render|striptags|trim %}
							{% if bathrooms is not empty %}
								<div class="box-icon">
									<div class="icons">
										<i class="icon-Ruler"></i>
									</div>
									<div class="content">
										<div class="text-4 text-color-default">Size:</div>
										<div class="text-1 text-color-heading">{{ bathrooms }}
											SqFt</div>
									</div>
								</div>
							{% endif %}
						</div>
					</div>
					{# <a href="#" class="tf-btn bg-color-primary pd-21 fw-6">Ask a question</a> #}
				</div>
				<div
					class="wg-property video">
					{# <div class="wg-title text-11 fw-6 text-color-heading">Video</div> #}
					<div class="widget-video style-1">


						{% if node.field_videos is not empty %}
							<div class="videos-wrapper">
								<h3>Videos</h3>

								{% for item in node.field_videos %}
									{% set video = item.entity %}

									{# Check if entity exists #}
									{% if video %}
										<div
											class="video-item">
											{# Get file URL #}
											{% set video_url = file_url(video.uri.value) %}

											{# HTML5 Video Player #}
											<video width="640" height="360" controls>
												<source src="{{ video_url }}" type="{{ video.filemime.value }}">
												Your browser does not support the video tag.
											</video>

										</div>
									{% endif %}
								{% endfor %}
							</div>
						{% endif %}
						{# <img data-src="/images/section/property-detail.jpg" alt="" loading="lazy" width="792" height="446" decoding="async" data-nimg="1" class="lazyload" style="color:transparent" srcset="/_next/image?url=%2Fimages%2Fsection%2Fproperty-detail.jpg&amp;w=828&amp;q=75 1x, /_next/image?url=%2Fimages%2Fsection%2Fproperty-detail.jpg&amp;w=1920&amp;q=75 2x" src="/_next/image?url=%2Fimages%2Fsection%2Fproperty-detail.jpg&amp;w=1920&amp;q=75"><a class="popup-youtube">
																																											<i class="icon-play"></i>
																																										</a> #}
					</div>
				</div>
				{# <div style="position: fixed; inset: 0px; background-color: rgba(0, 0, 0, 0.8); display: flex; justify-content: center; align-items: center; z-index: 1000;"><div style="position: relative; width: 90%; max-width: 1100px; background-color: rgb(255, 255, 255); border-radius: 4px; overflow: hidden; box-shadow: rgba(0, 0, 0, 0.2) 0px 0px 15px;"><button style="position: absolute; top: 10px; right: 10px; font-size: 30px; background: transparent; border-width: medium; border-style: none; border-color: currentcolor; border-image: initial; color: rgb(255, 255, 255); cursor: pointer; z-index: 1001;">×</button><div style="position: relative; padding-bottom: 56.25%; height: 0px; overflow: hidden;"><iframe src="https://www.youtube.com/embed/XHOmBV4js_E?autoplay=1" title="YouTube video player" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen="" style="position: absolute; top: 0px; left: 0px; width: 100%; height: 100%;"></iframe></div></div></div> #}
				<div class="wg-property box-property-detail">
					{{ node.field_property_details.value|raw }}
					<div class="box">
						<ul>
							{% set money = node.field_money.value|render|striptags|trim %}
							{% if money is not empty %}
								<li class="flex">
									<p class="fw-6">Price</p>
									<p>{{ node.field_money.value|render|striptags|trim }}</p>
								</li>
							{% endif %}
							{% set sqft = node.field_sqft.value|render|striptags|trim %}
							{% if sqft is not empty %}
								<li class="flex">
									<p class="fw-6">Size</p>
									<p>{{ sqft }}sqft</p>
								</li>
							{% endif %}
							{% set rooms = node.field_rooms.value|render|striptags|trim %}
							{% if rooms is not empty %}
								<li class="flex">
									<p class="fw-6">Rooms</p>
									<p>{{ rooms }}</p>
								</li>
							{% endif %}
							{% set bath = node.field_baths.value|render|striptags|trim %}
							{% if bath is not empty %}
								<li class="flex">
									<p class="fw-6">Baths</p>
									<p>{{ bath }}</p>
								</li>
							{% endif %}
						</ul>
						<ul>
							{% set bed = node.field_beds.value|render|striptags|trim %}
							{% if bed is not empty %}
								<li class="flex">
									<p class="fw-6">Beds</p>
									<p>{{ bed }}</p>
								</li>
							{% endif %}
							{% set property = node.field_properties.entity.label %}
							{% if property is not empty %}
								<li class="flex">
									<p class="fw-6">Type</p>
									<p>{{ property }}</p>
								</li>
							{% endif %}
							{% set trade = node.field_trade.entity.label %}
							{% if trade is not empty %}
								<li class="flex">
									<p class="fw-6">Status</p>
									<p>{{ trade }}</p>
								</li>
							{% endif %}
							{% set list = node.field_list.value|render|striptags|trim %}
							{% if list is not empty %}
								<li class="flex">
									<p class="fw-6">Garage</p>
									<p>{{ list }}</p>
								</li>
							{% endif %}
						</ul>
					</div>
				</div>
				{{ node.field_description.value|raw }}
			</div>
			<div class="col-xl-4 col-lg-5">
				<div class="tf-sidebar sticky-sidebar">
					<h4 class="heading-title mb-30">Contact Sellers</h4>

					{% if contact_form is defined and contact_form %}
						{{ contact_form }}
					{% endif %}

				</div>
			</div>

			<div class="tf-container">
				<div class="row">
					<div
						class="col-xl-8 col-lg-7">
						{# <div class="heading-section mb-48">
																		<h2 class="title">{{ node.title.value|striptags|trim }}</h2>
																	</div> #}
						{% if node.field_contact_us and not node.field_contact_us.isEmpty() %}
							<div class="tf-faq mb-49">
								<h3 class="fw-8 title mb-24">FAQ</h3>

								{# Check if field_contact_us exists and has content #}


								<div class="field-contact-us">

									<ul class="box-faq" id="wrapper-faq">
										{% for item in node.field_contact_us %}
											{% set paragraph = item.entity %}

											<li class="faq-item">
												{% set unique_id = 'accordion-faq-' ~ loop.index %}

												<a href="#{{ unique_id }}" class="faq-header h6 collapsed" data-bs-toggle="collapse" aria-expanded="false" aria-controls="{{ unique_id }}">
													{{ paragraph.field_title.value|default('FAQ Question') }}
													<i class="fas fa-chevron-down"></i>
												</a>

												<div id="{{ unique_id }}" class="collapse" data-bs-parent="#wrapper-faq">
												   <p class="faq-body">{{ paragraph.field_description.value|striptags|raw }}</p>
												</div>
											</li>
										{% endfor %}
									</ul>
								</div>


							</div>
						{% endif %}
					</div>
				</div>
			</div>
		</div>
	</div>
</section>
{%
  set classes = [
    'node',
    'node--type-' ~ node.bundle|clean_class,
    node.isPromoted() ? 'node--promoted',
    node.isSticky() ? 'node--sticky',
    not node.isPublished() ? 'node--unpublished',
    view_mode ? 'node--view-mode-' ~ view_mode|clean_class,
  ]
%}


{# Related Properties #}


{% if has_related_properties %}
	<section class="section-listing tf-spacing-1">

		<div class="tf-container">
			<div class="row">
				<div class="col-12">
					<div dir="ltr" class="swiper style-pagination tf-sw-mobile-1 sw-swiper-767 mobile-search" data-screen="767" data-preview="1" data-space="15">
						<h2 id="related-properties-title" class="related-properties__title">
							Similar Properties
						</h2>
						{# <div class="allsearch"> #}
						<div class="swiper-wrapper tf-layout-mobile-md md-col-2 lg-col-3">

							{% for item in related_properties %}
								<div class="swiper-slide">
									<div class="box-house hover-img">

										<div
											class="image-wrap">
											{# Or create your own link #}
											<a href="{{ item.url }}">
												<div class="search-test">
													{% if item.node.field_image is not empty %}
														{{ item.node.field_image|view('property_thumbnail') }}
													{% endif %}
												</div>
											</a>

											<ul class="box-tag flex gap-8">
												<li class="flat-tag text-4 bg-main fw-6 text_white">Featured</li>
												<li class="flat-tag text-4 bg-3 fw-6 text_white">For Sale</li>
											</ul>

											<div class="list-btn flex gap-8">
												<a href="#" class="btn-icon save hover-tooltip">
													<i class="icon-save"></i>
													<span class="tooltip">Add Favorite</span>
												</a>
												<a href="#" class="btn-icon find hover-tooltip">
													<i class="icon-find-plus"></i>
													<span class="tooltip">Quick View</span>
												</a>
											</div>
										</div>

										<div class="content">
											<h5 class="title">
												<a href="{{ item.url }}">{{ item.title }}</a>
											</h5>

											{% if item.body is defined and item.body.value is defined %}
												<p class="location text-1 line-clamp-1">
													<i class="icon-location"></i>
													{{ item.body.value|striptags|slice(0, 150) }}
													{% if item.body.value|length > 150 %}...
													{% endif %}
												</p>
											{% endif %}

											<ul class="meta-list flex">
												{% if item.beds is defined and item.beds.value is defined %}
													<li class="text-1 flex">
														<span>{{ item.beds.value }}
															Bed
															{% if item.beds.value > 1 %}s
															{% endif %}
														</span>
													</li>
												{% endif %}

												{% if item.baths is defined and item.baths.value is defined %}
													<li class="text-1 flex">
														<span>{{ item.baths.value|trim }}
															Bath
															{% if item.baths.value|trim > 1 %}s
															{% endif %}
														</span>
													</li>
												{% endif %}

												{% if item.sqft is defined and item.sqft.value is defined %}
													<li class="text-1 flex">
														<span>{{ item.sqft.value|number_format }}</span>Sqft
													</li>
												{% endif %}
											</ul>

											<div class="bot flex justify-between items-center">
												{% if item.money is defined and item.money.value is defined %}
													<h5 class="price">
														₹{{ item.money.value }}
													</h5>
												{% endif %}

												<div class="wrap-btn flex">
													{% if item.properties is defined and item.properties is not empty %}
														<a href="{{ item.url }}" class="compare flex gap-8 items-center text-1">
															{% for term in item.properties %}
																<span class="related-property__term">
																	{{ term.label }}
																</span>
															{% endfor %}
														</a>
													{% endif %}
													<a class="tf-btn style-border pd-4" href="{{ item.url }}">Details</a>
												</div>
											</div>
										</div>
									</div>
								</div>
							{% endfor %}

						</div>
						<!-- Close swiper-wrapper -->
					{# </div> #}
						<!-- Close allsearch -->
					</div>
					<!-- Close swiper -->

					<div class="sw-pagination sw-pagination-mb-1 text-center d-lg-none d-block"></div>
				</div>
				<!-- Close col-12 -->
			</div>
			<!-- Close row -->
		</div>
		<!-- Close tf-container -->
	</section>
	<!-- Close section-listing -->
{% endif %}
