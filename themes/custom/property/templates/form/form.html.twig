{#
/**
 * @file
 * Default theme implementation for a 'form' element.
 *
 * Available variables
 * - attributes: A list of HTML attributes for the wrapper element.
 * - children: The child elements of the form.
 *
 * @see template_preprocess_form()
 *
 * @ingroup themeable
 */
#}

{# {{ dump( element['#id']) }} #}

{% set id = element['#id']%}
{% if id == 'webform-submission-contact-us-add-form' %}
<div class="wrap-map"></div>
<div class="box">
<div class="tf-container">
<div class="row">
<div class="col-12">
<form{{ attributes }}>
<div class="heading-section"><h2 class="title">We Would Love to Hear From You</h2><p class="text-1">We'll get to know you to understand your selling goals, explain the selling process so you know what to expect.</p></div>
  {{ children }}
</form>
</div>
</div>
</div>
</div>
{% else %}
<form{{ attributes }}>
  {{ children }}
</form>
{% endif %}



