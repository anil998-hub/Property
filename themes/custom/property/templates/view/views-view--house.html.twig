									<i class="icon-garage"></i>Garage<span>2</span>
								</div>
							</li>
						</ul>
						<div class="bot flex justify-between items-center">
							<h5 class="price">8,600</h5>
							<div class="wrap-btn flex">
								<a class="tf-btn style-border pd-4" href="/property-detail-v1/27">Details</a>
							</div>
