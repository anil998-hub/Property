							<i class="icon-location"></i>
							Los Angeles, California 91604</p>
						<ul class="meta-list flex">
							<li class="meta-item">
								<div class="text-9 flex">
									<i class="icon-bed"></i>Beds<span>4</span>
								</div>
								<div class="text-9 flex">
									<i class="icon-sqft"></i>Sqft<span>1150</span>
								</div>
							</li>
							<li class="meta-item">
								<div class="text-9 flex">
