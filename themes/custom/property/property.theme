<?php


use Drupal\Core\Form\FormStateInterface;

use Drupal\node\Entity\Node;

/**
 * Implements hook_preprocess_views_view_unformatted().
 */
function property_preprocess_views_view_unformatted(&$variables) {
    $view = $variables['view'];
    
    // Optional: Filter for specific view (adjust view name as needed)
    if ($view->id() == 'property') {
    
        // Load taxonomy terms from 'property' vocabulary
        $term_storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
        $terms = $term_storage->loadTree('property');
        
        $property_terms = [];
        foreach ($terms as $term_data) {
            $term = $term_storage->load($term_data->tid);
            
            // Get image field value - CORRECTED
            $image_url = '';
            if ($term->hasField('field_icon') && !$term->get('field_icon')->isEmpty()) {
                $image_entity = $term->get('field_icon')->entity;
                if ($image_entity) {
                    // Method 1: Using file_url_generator service (Drupal 9+)
                    $image_url = \Drupal::service('file_url_generator')
                        ->generateString($image_entity->getFileUri());
                }
            }
            
            // Get description field value - FIXED (field_icons to proper field name)
            $description = '';
            if ($term->hasField('field_icons') && !$term->get('field_icons')->isEmpty()) {
                $description = $term->get('field_icons')->value;
            }
            
            // Alternative: If using taxonomy term description field (default)
            $term_description = $term->getDescription();
            
            $property_terms[] = [
                'id' => $term->id(),
                'name' => $term->getName(),
                'value' => $term->label(),
                'image' => $image_url,
                'description' => $description,
                'term_description' => $term_description,
            ];
        }
        
        // Pass to twig template
        $variables['property_terms'] = $property_terms;
        
        // If you only want the first term
        if (!empty($property_terms)) {
            $first_term = $property_terms[0];
            $variables['property_term_id'] = $first_term['id'];
            $variables['property_term_name'] = $first_term['name'];
            $variables['property_term_value'] = $first_term['value'];
            $variables['property_term_image'] = $first_term['image'];
            $variables['property_term_description'] = $first_term['description'];
        }
    }



$property_counts = [];

$terms = \Drupal::entityTypeManager()
  ->getStorage('taxonomy_term')
  ->loadTree('property');

foreach ($terms as $term) {

  $count = \Drupal::entityQuery('node')
    ->accessCheck(FALSE)
    ->condition('type', 'luxury_listings')
    ->condition('status', 1)
    ->condition('field_properties.target_id', $term->tid)
    ->count()
    ->execute();

  $property_counts[$term->tid] = $count;
}

$variables['property_counts'] = $property_counts;

       if ($view->id() == 'trading') {
    
        // Load taxonomy terms from 'property' vocabulary
        $term_storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
        $terms = $term_storage->loadTree('trading');
        
        $trading_terms = [];
        foreach ($terms as $term_data) {
            $term = $term_storage->load($term_data->tid);
            $trading_terms[] = [
                'id' => $term->id(),           // Term ID
                'name' => $term->getName(),     // Term Name/Value
                'value' => $term->label(),      // Term Value
            ];
        }
        
        // Pass to twig template
        $variables['trading_terms'] = $trading_terms;
        
        // If you only want the first term
        if (!empty($tradingproperty_terms)) {
            $first_term = $property_terms[0];
            $variables['trading_term_id'] = $first_term['id'];
            $variables['trading_term_name'] = $first_term['name'];
            $variables['trading_term_value'] = $first_term['value'];
        }
    }
}




function property_preprocess_node(&$variables) {
  $node = $variables['node'];
  
  if ($node->getType() == 'luxury_listings') {
    $variables['contact_form'] = [
      '#type' => 'webform',
      '#webform' => 'property_contact_form',
      '#ajax' => [
        'callback' => 'property_webform_ajax_callback',  // कस्टम callback
        'wrapper' => 'webform-wrapper',  // DOM wrapper ID
        'method' => 'replace',
        'effect' => 'fade',
      ],
      '#default_data' => [
        'property_nid' => $node->id(),
        'property_title' => $node->label(),
      ],
      '#entity_type' => 'node',
      '#entity_id' => $node->id(),
    ];
  }

  if ($node->getType() == 'luxury_listings') {
    // Get related properties
    $related_properties = property_get_related_properties($node, 6);
    
    if (!empty($related_properties)) {
      $variables['related_properties'] = $related_properties;
      $variables['has_related_properties'] = TRUE;
    } else {
      $variables['related_properties'] = [];
      $variables['has_related_properties'] = FALSE;
    }
  }
}

/**
 * Implements hook_preprocess_field().
 */
function property_preprocess_field(&$variables, $hook) {
  // Target only the field_list field
  if ($variables['field_name'] == 'field_list') {
    $star_values = [];
    
    foreach ($variables['items'] as $key => $item) {
      // Get the integer value
      $value = (int) $item['content']['#context']['value'];
      
      // Generate HTML for stars
      $stars_html = '';
      for ($i = 1; $i <= $value; $i++) {
        $stars_html .= '<span class="star">★</span>';
      }
      
      $star_values[] = [
        'stars' => $stars_html,
        'count' => $value,
      ];
    }
    
    $variables['star_items'] = $star_values;
  }
}




/**
 * @file
 * Theme file for custom theme.
 */

/**
 * Implements hook_form_alter().
 */
function property_form_alter(&$form, FormStateInterface $form_state, $form_id){

  if ($form_id == 'user_register_form') {
    $form['actions']['submit']['#value'] = t('Sign Up');
    $form['account']['name']['#attributes']['class'][] = 'form-control';
    $form['account']['mail']['#attributes']['class'][] = 'form-control';
    $form['account']['pass']['#attributes']['class'][] = 'form-control';

    unset($form['account']['name']['#description']);
    unset($form['account']['mail']['#description']);
    unset($form['account']['pass']['#description']);
    unset($form['pass']['pass2']);
  }
  if ($form_id == 'user_login_form') {
    $form['actions']['submit']['#value'] = t('Login');
   $form['name']['#title'] = t('Email ID');
    $form['#submit'][] = 'property_user_login_redirect';
  }

   if ($form_id == 'webform-submission-contact-us-add-form') {
    $form['actions']['submit']['#value'] = t('Sign Up');
    $form['account']['name']['#attributes']['class'][] = 'form-control';
    $form['account']['mail']['#attributes']['class'][] = 'form-control';
    $form['account']['pass']['#attributes']['class'][] = 'form-control';

    unset($form['account']['name']['#description']);
    unset($form['account']['mail']['#description']);
    unset($form['account']['pass']['#description']);
    unset($form['pass']['pass2']);
  }
}

/**
 * Custom submit handler to redirect after login.
 */
function property_user_login_redirect(array &$form, FormStateInterface $form_state) {
  // Redirect to the homepage.
  $form_state->setRedirect('<front>');
}


/**
 * Implements hook_theme_suggestions_form_alter().
 */
function property_theme_suggestions_form_alter(array &$suggestions, array $variables) {
  if ($variables['element']['#form_id'] == 'user_register_form') {
    $suggestions[] = 'form__user_register_form';
  }
  if ($variables['element']['#form_id'] == 'user_login_form') {
    $suggestions[] = 'form__user_login_form';
  }
   if ($variables['element']['#form_id'] == 'webform_submission_contact_us_add_form') {
    $suggestions[] = 'form__webform_submission_contact_us_add_form';
  }
  
}





